<p>Hi<%= @user.name.present? ? " #{@user.name}" : "" %>,</p>

<%= simple_format(@entry.body) %>

<hr>
<p>
  Your report from <%= l(@error_report.created_at.to_date, format: :long) %> about
  <% if (url = error_report_page_url(@error_report)) %>
    <%= link_to @error_report.reportable_name, url %>:
  <% else %>
    <%= @error_report.reportable_name %>:
  <% end %>
</p>
<blockquote><%= simple_format(@error_report.description) %></blockquote>
